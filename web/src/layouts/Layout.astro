---
import { Font } from 'astro:assets'

import '../styles/globals.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Greg shared a file with you' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="bg-base font-sans text-slate-900">
    <slot />
  </body>
</html>
