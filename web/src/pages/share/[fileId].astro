---
import { env } from 'cloudflare:workers'

import { ShareButton } from '../../components/Button'
import { DataPreview } from '../../components/DataPreview'
import Layout from '../../layouts/Layout.astro'
import { fileIdSchema } from '../../schemas/fileId'
import {
  CONTENT_TYPE_SNIFF_BYTE_LENGTH,
  getRelativeTimeString,
  resolveContentType,
} from '../../utils'

type FileKind =
  | 'image'
  | 'video'
  | 'audio'
  | 'html'
  | 'pdf'
  | 'json'
  | 'csv'
  | 'unsupported'

function getFileKind(contentType: string): FileKind {
  switch (contentType) {
    case 'text/html':
      return 'html'
    case 'application/pdf':
      return 'pdf'
    case 'application/json':
      return 'json'
    case 'text/csv':
      return 'csv'
    default:
      if (contentType.startsWith('image/')) return 'image'
      if (contentType.startsWith('video/')) return 'video'
      if (contentType.startsWith('audio/')) return 'audio'
      return 'unsupported'
  }
}

const safeParse = fileIdSchema.safeParse(Astro.params)

if (!safeParse.success) {
  return Astro.rewrite('/404')
}

const { fileId } = safeParse.data
const file = await env.R2.get(fileId, {
  range: { offset: 0, length: CONTENT_TYPE_SNIFF_BYTE_LENGTH },
})

if (!file) {
  return Astro.rewrite('/404')
}

const contentType = resolveContentType(
  file.httpMetadata?.contentType,
  await file.arrayBuffer(),
  file.customMetadata?.filename,
)

const title = file.customMetadata?.title || 'Untitled'
const relativeDate = getRelativeTimeString(file.uploaded)
const description = `Updated ${relativeDate}`
const cdnUrl = new URL(`/cdn/${fileId}`, Astro.url).href
const fileKind = getFileKind(contentType)
const filename = file.customMetadata?.filename || title
const audioFormat =
  file.customMetadata?.filename?.split('.').pop()?.toUpperCase() || 'AUDIO'
---

<Layout
  title={title}
  description={description}
  og={{
    title,
    description,
    url: Astro.url.href,
    type: fileKind === 'video' ? 'video.other' : 'website',
    ...(fileKind === 'image' && { image: cdnUrl }),
  }}
>
  <main
    class="mx-auto flex min-h-svh max-w-7xl flex-col justify-center p-4 sm:p-10"
  >
    <div
      class="flex flex-col items-center justify-between gap-6 sm:flex-row"
    >
      <div class="flex flex-col gap-0.5">
        <h1 class="text-2xl font-bold">{title}</h1>
        <span class="block text-sm text-slate-500">
          Updated{' '}
          <time datetime={file.uploaded.toString()}>{relativeDate}</time>
        </span>
      </div>

      <ShareButton fileId={fileId} client:load />
    </div>

    {
      fileKind === 'pdf' ? (
        <section class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/10">
          <div class="flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-red-50 text-xs font-bold tracking-wide text-red-600 ring-1 ring-red-100">
                PDF
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-800">
                  {file.customMetadata?.filename || title}
                </p>
                <p class="text-xs text-slate-500">
                  PDF document · Preview
                </p>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <a
                href={cdnUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:bg-slate-50"
              >
                Open PDF
              </a>
              <a
                href={cdnUrl}
                download={file.customMetadata?.filename || `${title}.pdf`}
                class="inline-flex items-center justify-center rounded-full bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
              >
                Download
              </a>
            </div>
          </div>

          <div class="flex min-h-80 flex-col items-center justify-center gap-4 bg-slate-50 px-6 py-14 text-center sm:hidden">
            <div class="flex size-16 items-center justify-center rounded-2xl bg-red-50 text-lg font-bold tracking-wide text-red-600 ring-1 ring-red-100">
              PDF
            </div>
            <div class="max-w-xs">
              <p class="font-semibold text-slate-800">Ready to view</p>
              <p class="mt-1 text-sm leading-6 text-slate-500">
                Open this document in your browser's full PDF viewer for the
                best mobile experience.
              </p>
            </div>
            <a
              href={cdnUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
            >
              View full PDF
            </a>
          </div>

          <iframe
            src={`${cdnUrl}#view=FitH&toolbar=1`}
            title={`${title} PDF preview`}
            class="hidden h-[calc(100svh-14rem)] min-h-[32rem] max-h-[72rem] w-full bg-slate-100 sm:block"
          />
        </section>
      ) : fileKind === 'audio' ? (
        <section class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/10">
          <div class="flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-[10px] font-bold tracking-wide text-violet-700 ring-1 ring-violet-100">
                {audioFormat}
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-800">
                  {filename}
                </p>
                <p class="text-xs text-slate-500">Audio file · Player</p>
              </div>
            </div>

            <a
              href={cdnUrl}
              download={filename}
              class="inline-flex items-center justify-center rounded-full bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
            >
              Download
            </a>
          </div>

          <div class="flex min-h-64 flex-col items-center justify-center gap-6 bg-gradient-to-br from-violet-50 via-white to-sky-50 px-6 py-12">
            <div class="flex size-20 items-center justify-center rounded-full bg-white text-violet-600 shadow-lg shadow-violet-900/10 ring-1 ring-violet-100">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="size-9"
                aria-hidden="true"
              >
                <path d="M9 18V5l10-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="16" cy="16" r="3"></circle>
              </svg>
            </div>
            <audio
              src={`/cdn/${file.key}`}
              controls
              preload="metadata"
              class="w-full max-w-2xl"
            >
              Your browser does not support audio playback.
            </audio>
          </div>
        </section>
      ) : fileKind === 'json' || fileKind === 'csv' ? (
        <section class="mt-5 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/10">
          <div class="flex flex-col gap-3 border-b border-slate-200 bg-white px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-center gap-3">
              <div
                class:list={[
                  'flex size-10 shrink-0 items-center justify-center rounded-xl text-[11px] font-bold tracking-wide ring-1',
                  fileKind === 'json'
                    ? 'bg-sky-50 text-sky-700 ring-sky-100'
                    : 'bg-emerald-50 text-emerald-700 ring-emerald-100',
                ]}
              >
                {fileKind === 'json' ? 'JSON' : 'CSV'}
              </div>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-800">
                  {filename}
                </p>
                <p class="text-xs text-slate-500">
                  {fileKind === 'json' ? 'JSON data · Formatted preview' : 'CSV data · Table preview'}
                </p>
              </div>
            </div>

            <a
              href={cdnUrl}
              download={filename}
              class="inline-flex items-center justify-center rounded-full bg-primary px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-hover"
            >
              Download
            </a>
          </div>

          <DataPreview
            src={`/cdn/${file.key}`}
            kind={fileKind}
            client:load
          />
        </section>
      ) : (
        <div class="mt-3 overflow-hidden rounded-lg bg-slate-200 shadow-md">
      {
        fileKind === 'image' ? (
          <img src={`/cdn/${file.key}`} alt={title} />
        ) : fileKind === 'video' ? (
          <video
            src={`/cdn/${file.key}`}
            class="aspect-video w-full"
            controls
          />
        ) : fileKind === 'html' ? (
          <div class="flex flex-col items-center justify-center gap-3 px-4 py-24 text-center">
            <span class="text-slate-600">Interactive HTML file</span>
            <a
              href={cdnUrl}
              rel="noopener noreferrer"
              class="rounded-full bg-primary px-4 py-2 text-sm font-medium text-slate-50 transition-colors hover:bg-primary-hover"
            >
              Open HTML preview
            </a>
          </div>
        ) : (
          <span class="block items-center justify-center px-4 py-24 text-center">
            Unsupported file type
          </span>
        )
      }
        </div>
      )
    }
  </main>
</Layout>
